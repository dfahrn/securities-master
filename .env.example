# Application database (Docker Compose maps 5433 -> container 5432)
DATABASE_URL=postgresql+psycopg://sm:sm@localhost:5433/securities_master
# Test database, same server, separate database
TEST_DATABASE_URL=postgresql+psycopg://sm:sm@localhost:5433/securities_master_test
# SEC requires a contact string; requests without one are blocked.
SEC_USER_AGENT="Your Name your.email@example.com"
